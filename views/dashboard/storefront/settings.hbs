<header style="display: block;">
    <h1>Shop Settings</h1>
    <p style="color: var(--text-muted); margin-top: 8px;">Manage your storefront's public information and contact details.</p>
</header>

<section class="form-card glass-effect">
    {{#if error}}
    <div class="alert error-alert">
        <iconify-icon icon="lucide:alert-circle" style="font-size: 20px;"></iconify-icon>
        <span>{{error}}</span>
    </div>
    {{/if}}

    {{#if success}}
    <div class="alert success-alert">
        <iconify-icon icon="lucide:check-circle" style="font-size: 20px;"></iconify-icon>
        <span>Settings updated successfully!</span>
    </div>
    {{/if}}

    <form action="/dashboard/storefront" method="POST">
        <div class="form-grid">
            <div class="form-group full-width">
                <label for="name">Shop Name</label>
                <input type="text" id="name" name="name" value="{{storefront.name}}" placeholder="Your Shop Name" required>
                <div class="form-tip">This is the name customers will see on your storefront.</div>
            </div>

            <div class="form-group full-width">
                <label for="about">About / Shop Description</label>
                <textarea id="about" name="about" placeholder="Tell your customers about your shop..." rows="4">{{storefront.about}}</textarea>
            </div>

            <div class="form-group">
                <label for="contactEmail">Contact Email</label>
                <input type="email" id="contactEmail" name="contactEmail" value="{{storefront.contactEmail}}" placeholder="contact@yourshop.com">
            </div>

            <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" value="{{storefront.phone}}" placeholder="+1 (555) 000-0000">
            </div>

            <div class="form-group full-width">
                <label for="contactAddress">Physical Address</label>
                <textarea id="contactAddress" name="contactAddress" placeholder="Your shop's physical location..." rows="2">{{storefront.contactAddress}}</textarea>
            </div>
        </div>

        <div class="form-footer">
            <button type="submit" class="submit-button">Save Changes</button>
        </div>
    </form>
</section>

<style>
    .form-card {
        max-width: 800px;
        padding: 40px;
        border-radius: 24px;
        box-shadow: var(--shadow);
        margin-top: 32px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    .full-width {
        grid-column: span 2;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
    }

    input, textarea {
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: #f8fafc;
        font-size: 15px;
        transition: all 0.2s ease;
        outline: none;
        font-family: inherit;
    }

    input:focus, textarea:focus {
        background: #fff;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .form-tip {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 4px;
    }

    .form-footer {
        margin-top: 40px;
        display: flex;
        justify-content: flex-end;
        padding-top: 32px;
        border-top: 1px solid var(--border);
    }

    .submit-button {
        padding: 12px 32px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    .submit-button:hover {
        background: var(--primary-hover);
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
    }

    .alert {
        padding: 16px;
        border-radius: 12px;
        margin-bottom: 32px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        font-weight: 500;
    }

    .error-alert {
        background-color: #fef2f2;
        border: 1px solid #fee2e2;
        color: #991b1b;
    }

    .success-alert {
        background-color: #f0fdf4;
        border: 1px solid #dcfce7;
        color: #166534;
    }
</style>
