<header>
    <h1>Add New Product</h1>
</header>

<section class="form-card glass-effect">
    {{#if error}}
    <div class="error-alert">
        <iconify-icon icon="lucide:alert-circle" style="font-size: 20px;"></iconify-icon>
        <span>{{error}}</span>
    </div>
    {{/if}}

    <form action="/dashboard/products/create" method="POST" enctype="multipart/form-data">
        <div class="form-grid">
            <div class="form-group full-width">
                <label for="images">Product Images</label>
                <div class="file-upload-container">
                    <input type="file" id="images" name="images" multiple accept="image/*" class="file-input">
                    <div class="file-upload-placeholder">
                        <iconify-icon icon="lucide:upload-cloud" style="font-size: 32px;"></iconify-icon>
                        <p>Click or drag to upload multiple images</p>
                    </div>
                </div>
            </div>

            <div class="form-group full-width">
                <label for="productName">Product Name</label>
                <input type="text" id="productName" name="productName" placeholder="e.g. Wireless Headphones" required>
            </div>

            <div class="form-group full-width">
                <label for="description">Description</label>
                <textarea id="description" name="description" placeholder="A brief description of the product..." rows="4"></textarea>
            </div>

            <div class="form-group">
                <label for="category">Category</label>
                <select id="category" name="category" required>
                    <option value="" disabled selected>Select a category</option>
                    {{#each categories}}
                    <option value="{{this._id}}">{{this.name}}</option>
                    {{/each}}
                </select>
                <div class="form-tip">Don't see your category? <a href="/dashboard/categories/create">Add one here</a>.</div>
            </div>

            <div class="form-group">
                <label for="price">Price</label>
                <input type="number" id="price" name="price" step="0.01" placeholder="0.00" required>
            </div>

            <div class="form-group">
                <label for="currency">Currency</label>
                <select id="currency" name="currency" required>
                    <option value="USD">USD - US Dollar</option>
                    <option value="NGN">NGN - Nigerian Naira</option>
                    <option value="EUR">EUR - Euro</option>
                </select>
            </div>

            <div class="form-group">
                <label for="quantity">Initial Quantity</label>
                <input type="number" id="quantity" name="quantity" placeholder="0" required>
            </div>
        </div>

        <div class="form-footer">
            <a href="/dashboard/products" class="cancel-button">Cancel</a>
            <button type="submit" class="submit-button">Create Product</button>
        </div>
    </form>
</section>

<style>
    .form-card {
        max-width: 800px;
        padding: 40px;
        border-radius: 24px;
        box-shadow: var(--shadow);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    .full-width {
        grid-column: span 2;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
    }

    input, textarea, select {
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: #f8fafc;
        font-size: 15px;
        transition: all 0.2s ease;
        outline: none;
        font-family: inherit;
    }

    input:focus, textarea:focus, select:focus {
        background: #fff;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .form-tip {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 4px;
    }

    .form-tip a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
    }

    .form-footer {
        margin-top: 40px;
        display: flex;
        justify-content: flex-end;
        gap: 16px;
        padding-top: 32px;
        border-top: 1px solid var(--border);
    }

    .cancel-button {
        padding: 12px 24px;
        border-radius: 12px;
        text-decoration: none;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 15px;
        transition: all 0.2s;
    }

    .cancel-button:hover {
        background: #f1f5f9;
        color: var(--text-main);
    }

    .submit-button {
        padding: 12px 32px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    .submit-button:hover {
        background: var(--primary-hover);
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
    }

    .error-alert {
        background-color: #fef2f2;
        border: 1px solid #fee2e2;
        color: #991b1b;
        padding: 16px;
        border-radius: 12px;
        margin-bottom: 32px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        font-weight: 500;
    }

    .file-upload-container {
        position: relative;
        width: 100%;
        min-height: 150px;
        border: 2px dashed var(--border);
        border-radius: 16px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        overflow: hidden;
    }

    .file-upload-container:hover {
        border-color: var(--primary);
        background: rgba(99, 102, 241, 0.05);
    }

    .file-input {
        position: absolute;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 2;
    }

    .file-upload-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        color: var(--text-muted);
        pointer-events: none;
    }

    .file-upload-placeholder p {
        font-size: 14px;
        font-weight: 500;
    }
</style>
