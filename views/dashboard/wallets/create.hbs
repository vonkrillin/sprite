<header>
    <h1>Create New Wallet</h1>
</header>

<section class="form-card glass-effect">
    {{#if error}}
    <div class="error-alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>{{error}}</span>
    </div>
    {{/if}}

    <form action="/dashboard/wallets/create" method="POST" id="create-wallet-form">
        <div class="form-group">
            <label>Select Network Provider</label>
            <div class="provider-grid">
                {{#each providers}}
                <label class="provider-card">
                    <input type="radio" name="provider" value="{{this}}" required>
                    <div class="card-content">
                        <div class="provider-badge">{{this}}</div>
                        <div class="provider-details">
                            <span class="name">{{this}} Network</span>
                            <span class="desc">Create a secure {{this}} address for your organization.</span>
                        </div>
                        <div class="select-indicator">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                    </div>
                </label>
                {{/each}}
            </div>
        </div>

        <div class="form-footer">
            <a href="/dashboard/wallets" class="cancel-button">Cancel</a>
            <button type="submit" class="submit-button">Initialize Wallet</button>
        </div>
    </form>
</section>

<style>
    .form-card {
        max-width: 900px;
        padding: 48px;
        border-radius: 32px;
        box-shadow: var(--shadow-lg);
    }

    .form-group {
        margin-bottom: 40px;
    }

    label {
        display: block;
        font-size: 16px;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 24px;
        letter-spacing: -0.01em;
    }

    .provider-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
    }

    .provider-card {
        position: relative;
        cursor: pointer;
        margin-bottom: 0;
    }

    .provider-card input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }

    .card-content {
        padding: 24px;
        background: #f8fafc;
        border: 2px solid var(--border);
        border-radius: 20px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        gap: 20px;
        height: 100%;
        position: relative;
    }

    .provider-card:hover .card-content {
        border-color: var(--primary);
        background: white;
        transform: translateY(-4px);
    }

    .provider-card input:checked + .card-content {
        background: white;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .provider-badge {
        width: fit-content;
        padding: 6px 12px;
        background: white;
        border: 1px solid var(--border);
        border-radius: 10px;
        font-size: 11px;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .provider-details {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .provider-details .name {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-main);
    }

    .provider-details .desc {
        font-size: 14px;
        color: var(--text-muted);
        line-height: 1.5;
    }

    .select-indicator {
        position: absolute;
        top: 24px;
        right: 24px;
        width: 24px;
        height: 24px;
        background: var(--primary);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transform: scale(0.5);
        transition: all 0.2s;
    }

    .provider-card input:checked + .card-content .select-indicator {
        opacity: 1;
        transform: scale(1);
    }

    .form-footer {
        margin-top: 48px;
        display: flex;
        justify-content: flex-end;
        gap: 20px;
        padding-top: 32px;
        border-top: 1px solid var(--border);
    }

    .cancel-button {
        padding: 14px 28px;
        border-radius: 12px;
        text-decoration: none;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 15px;
        transition: all 0.2s;
    }

    .cancel-button:hover {
        background: #f1f5f9;
        color: var(--text-main);
    }

    .submit-button {
        padding: 14px 40px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    .submit-button:hover {
        background: var(--primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
    }

    .error-alert {
        background-color: #fef2f2;
        border: 1px solid #fee2e2;
        color: #991b1b;
        padding: 16px 20px;
        border-radius: 16px;
        margin-bottom: 32px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        font-weight: 500;
    }
</style>
