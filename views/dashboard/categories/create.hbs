<header>
    <h1>Add New Category</h1>
</header>

<section class="form-card glass-effect">
    {{#if error}}
    <div class="error-alert">
        <iconify-icon icon="lucide:alert-circle" style="font-size: 20px;"></iconify-icon>
        <span>{{error}}</span>
    </div>
    {{/if}}

    <form action="/dashboard/categories/create" method="POST">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input type="text" id="name" name="name" placeholder="e.g. Electronics" required>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" placeholder="A brief description of this category..." rows="4"></textarea>
        </div>

        <div class="form-footer">
            <a href="/dashboard/products/create" class="cancel-button">Back to Product Create</a>
            <button type="submit" class="submit-button">Create Category</button>
        </div>
    </form>
</section>

<style>
    .form-card {
        max-width: 600px;
        padding: 40px;
        border-radius: 24px;
        box-shadow: var(--shadow);
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 24px;
    }

    label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
    }

    input, textarea {
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: #f8fafc;
        font-size: 15px;
        transition: all 0.2s ease;
        outline: none;
        font-family: inherit;
    }

    input:focus, textarea:focus {
        background: #fff;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .form-footer {
        margin-top: 40px;
        display: flex;
        justify-content: flex-end;
        gap: 16px;
        padding-top: 32px;
        border-top: 1px solid var(--border);
    }

    .cancel-button {
        padding: 12px 24px;
        border-radius: 12px;
        text-decoration: none;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 15px;
        transition: all 0.2s;
    }

    .cancel-button:hover {
        background: #f1f5f9;
        color: var(--text-main);
    }

    .submit-button {
        padding: 12px 32px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    .submit-button:hover {
        background: var(--primary-hover);
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
    }

    .error-alert {
        background-color: #fef2f2;
        border: 1px solid #fee2e2;
        color: #991b1b;
        padding: 16px;
        border-radius: 12px;
        margin-bottom: 32px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        font-weight: 500;
    }
</style>
