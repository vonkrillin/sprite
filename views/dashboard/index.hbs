<header>
    <h1>Overview</h1>
    <div class="user-profile">
        <div class="avatar">
            <iconify-icon icon="lucide:user"></iconify-icon>
        </div>
        <span>{{#if organization}}{{organization.name}}{{else}}Welcome back!{{/if}}</span>
    </div>
</header>

<section class="stats-grid">
    <div class="stat-card glass-effect">
        <div class="stat-header">
            <h3>Total Products</h3>
            <iconify-icon icon="lucide:box" class="stat-icon"></iconify-icon>
        </div>
        <div class="value">{{stats.totalProducts}}</div>
        <div class="trend">Manage inventory</div>
    </div>
    <div class="stat-card glass-effect">
        <div class="stat-header">
            <h3>Product Categories</h3>
            <iconify-icon icon="lucide:folder-tree" class="stat-icon"></iconify-icon>
        </div>
        <div class="value">{{stats.totalCategories}}</div>
        <div class="trend">Browse taxonomies</div>
    </div>
    <div class="stat-card glass-effect">
        <div class="stat-header">
            <h3>Active Wallets</h3>
            <iconify-icon icon="lucide:wallet-cards" class="stat-icon"></iconify-icon>
        </div>
        <div class="value">{{stats.totalWallets}}</div>
        <div class="trend">Manage crypto assets</div>
    </div>
</section>

<section class="recent-activity-container">
    <div class="recent-section glass-effect">
        <h2>Recently Added Products</h2>
        <div class="activity-list">
            {{#each recentProducts}}
            <div class="activity-item">
                <div class="icon-box">
                    <iconify-icon icon="lucide:package"></iconify-icon>
                </div>
                <div class="details">
                    <p class="title">{{this.productName}}</p>
                    <p class="time">{{this.category.name}} • {{formatCurrency this.price this.currency}}</p>
                </div>
            </div>
            {{else}}
            <div class="empty-activity">
                <iconify-icon icon="lucide:package-open" style="font-size: 32px; opacity: 0.5; margin-bottom: 12px;"></iconify-icon>
                <p>No products added yet. <a href="/dashboard/products/create">Create your first product.</a></p>
            </div>
            {{/each}}
        </div>
    </div>

    <div class="quick-actions glass-effect">
        <h2>Quick Actions</h2>
        <div class="action-grid">
            <a href="/dashboard/products/create" class="action-btn">
                <iconify-icon icon="lucide:plus-circle" class="btn-icon"></iconify-icon>
                <span>Add Product</span>
            </a>
            <a href="/dashboard/wallets/create" class="action-btn">
                <iconify-icon icon="lucide:wallet" class="btn-icon"></iconify-icon>
                <span>New Wallet</span>
            </a>
            <a href="/dashboard/categories/create" class="action-btn">
                <iconify-icon icon="lucide:folder-plus" class="btn-icon"></iconify-icon>
                <span>New Category</span>
            </a>
        </div>
    </div>
</section>

<style>
    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
    }

    .stat-icon {
        font-size: 24px;
        color: var(--primary);
        opacity: 0.8;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 24px;
        margin-bottom: 48px;
    }

    .stat-card {
        padding: 24px;
        border-radius: 20px;
        box-shadow: var(--shadow);
    }

    .stat-card h3 {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-muted);
    }

    .stat-card .value {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .stat-card .trend {
        font-size: 12px;
        font-weight: 500;
        color: var(--primary);
    }

    .recent-activity-container {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 32px;
    }

    .recent-section, .quick-actions {
        padding: 32px;
        border-radius: 24px;
        box-shadow: var(--shadow);
    }

    .recent-section h2, .quick-actions h2 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 24px;
    }

    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .icon-box {
        width: 40px;
        height: 40px;
        background: #f8fafc;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: var(--primary);
    }

    .activity-item .details .title {
        font-weight: 600;
        font-size: 15px;
    }

    .activity-item .details .time {
        font-size: 12px;
        color: var(--text-muted);
    }

    .empty-activity {
        text-align: center;
        padding: 40px 0;
        color: var(--text-muted);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .empty-activity a {
        color: var(--primary);
        font-weight: 600;
        text-decoration: none;
    }

    .action-grid {
        display: grid;
        gap: 12px;
    }

    .action-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 16px;
        text-decoration: none;
        color: var(--text-main);
        font-weight: 600;
        transition: all 0.2s;
    }

    .btn-icon {
        font-size: 20px;
        color: var(--primary);
    }

    .action-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: white;
        transform: translateX(4px);
    }

    .avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    @media (max-width: 1024px) {
        .recent-activity-container {
            grid-template-columns: 1fr;
        }
    }
</style>
